# Local demo — DEBUG on, weak key is fine.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HSTS_SECONDS=0

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Black Shell Website <onboarding@resend.dev>
CONTACT_TO_EMAIL=projects@blackshell.tech

# Production / Railway (copy these, then fill them in):
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=   # python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DJANGO_ALLOWED_HOSTS=blackshell.tech,www.blackshell.tech,<app>.up.railway.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://blackshell.tech,https://www.blackshell.tech,https://<app>.up.railway.app
# DJANGO_SECURE_SSL_REDIRECT=False
# DJANGO_HSTS_SECONDS=0
# DATABASE_URL=
# EDITOR_PASSWORD=     # required by seed_site when DEBUG is off
# EMAIL_HOST=smtp.resend.com
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Black Shell Website <projects@blackshell.tech>

# Railway: leave DJANGO_SECURE_SSL_REDIRECT=False until the *.up.railway.app
# URL is healthy, then set True. DATABASE_URL is injected by the Postgres
# plugin. ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS must include that host.
